---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import interLatinWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import jetbrainsMonoLatinWoff2 from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { identity, navigation, siteMeta, type NavLink } from '../data/content';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  includePersonSchema?: boolean;
  brandHref?: string;
  navLinks?: NavLink[];
}

const {
  title = siteMeta.title,
  description = siteMeta.description,
  canonical = siteMeta.canonical,
  ogImage = siteMeta.ogImage,
  ogImageAlt = siteMeta.ogImageAlt,
  noindex = false,
  includePersonSchema = true,
  brandHref = '#home',
  navLinks = navigation,
} = Astro.props;

const absoluteOgImage = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, siteMeta.canonical).toString();

const [locality, countryName] = identity.location.split(',').map((s) => s.trim());

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: identity.name,
  alternateName: identity.handle,
  jobTitle: identity.role,
  url: identity.siteUrl,
  email: `mailto:${identity.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: locality,
    addressCountry: countryName === 'Sri Lanka' ? 'LK' : countryName,
  },
  sameAs: [identity.github, identity.linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        let theme = null;
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'dark' || saved === 'light') {
            theme = saved;
          }
        } catch {
          // Ignore storage access errors
        }
        if (!theme) {
          theme = window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark';
        }
        root.dataset.theme = theme;
      })();
    </script>

    <link
      rel="preload"
      href={interLatinWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={jetbrainsMonoLatinWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" type="image/svg+xml" href={siteMeta.favicon} />
    <link rel="canonical" href={canonical} />

    <meta name="description" content={description} />
    <meta name="author" content={identity.name} />
    <meta name="theme-color" content="#0b0f14" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteMeta.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    {
      includePersonSchema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(personSchema)}
        />
      )
    }
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <Navbar brandName={identity.name} brandHref={brandHref} links={navLinks} />

    <main id="main-content">
      <slot />
    </main>

    <Footer ownerName={identity.name} />
  </body>
</html>
