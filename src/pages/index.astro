---
import BaseLayout from '../layouts/BaseLayout.astro';

const placeholderSections = [
  { id: 'about', label: 'About' },
  { id: 'experience', label: 'Experience' },
  { id: 'projects', label: 'Projects' },
  { id: 'skills', label: 'Skills' },
  { id: 'credentials', label: 'Certifications and Education' },
  { id: 'contact', label: 'Contact' },
];
---

<BaseLayout>
  <section id="home" class="section" aria-labelledby="temp-hero-heading">
    <div class="container">
      <div class="stage-placeholder">
        <p class="eyebrow">STAGE 2 TEMPORARY SHELL</p>
        <h1 id="temp-hero-heading">Temporary Hero Anchor</h1>
        <p>
          Placeholder content for Stage 2 testing of layout, theme, and
          navigation. Real portfolio copy arrives in Stages 3 and 4.
        </p>
      </div>
    </div>
  </section>

  {
    placeholderSections.map((item) => (
      <section
        id={item.id}
        class="section"
        aria-labelledby={`temp-${item.id}-heading`}
      >
        <div class="container">
          <div class="stage-placeholder">
            <p class="eyebrow">TEMPORARY ANCHOR #{item.id}</p>
            <h2 id={`temp-${item.id}-heading`}>{item.label}</h2>
            <p>Placeholder section for Stage 2 anchor scroll verification.</p>
          </div>
        </div>
      </section>
    ))
  }
</BaseLayout>
