---
import type { CertificationItem, EducationItem } from '../data/content';

interface Props {
  id: string;
  eyebrow: string;
  heading: string;
  certifications: CertificationItem[];
  education: EducationItem[];
}

const { id, eyebrow, heading, certifications, education } = Astro.props;
---

<section id={id} class="section" aria-labelledby="credentials-heading">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="credentials-heading" class="section-title">{heading}</h2>
    </div>

    <div class="credentials-grid">
      <div class="credentials-column">
        <h3 class="column-title">Certifications</h3>
        <ul class="credentials-list">
          {
            certifications.map((cert) => (
              <li class="card credential-item">
                <p class="credential-title">{cert.title}</p>
                <p class="credential-meta">
                  <span>{cert.issuer}</span>
                  <span class="credential-date">{cert.date}</span>
                </p>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="credentials-column">
        <h3 class="column-title">Education</h3>
        <ul class="credentials-list">
          {
            education.map((edu) => (
              <li class="card credential-item">
                <p class="credential-title">{edu.degree}</p>
                <p class="credential-date">{edu.period}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .credentials-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.9fr);
    gap: var(--space-8);
    align-items: start;
  }

  .credentials-column {
    min-width: 0;
  }

  .column-title {
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .credentials-list {
    display: grid;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .credential-item {
    padding: var(--space-4) var(--space-6);
    min-width: 0;
  }

  .credential-title {
    margin-bottom: var(--space-1);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text);
  }

  .credential-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    margin-bottom: 0;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .credential-date {
    margin-bottom: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent);
  }

  @media (max-width: 840px) {
    .credentials-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
