---
import type { SkillGroup } from "../data/content";

interface Props {
  id: string;
  eyebrow?: string;
  heading: string;
  groups: SkillGroup[];
}

const { id, eyebrow, heading, groups } = Astro.props;
---

<section id={id} class="section" aria-labelledby="skills-heading">
  <div class="container">
    <div class="section-header">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 id="skills-heading" class="section-title">
        {heading}
      </h2>
    </div>

    <div class="skills-grid">
      {groups.map((group) => (
        <article class="card skill-card">
          <h3 class="skill-title">{group.title}</h3>
          <ul class="chip-list" aria-label={group.title}>
            {group.items.map((item) => (
              <li class="chip">{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .skill-card {
    min-width: 0;
  }

  .skill-title {
    margin-bottom: var(--space-4);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (max-width: 767px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
