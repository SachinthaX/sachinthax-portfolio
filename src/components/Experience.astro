---
import type { ExperienceItem } from '../data/content';

interface Props {
  id: string;
  eyebrow: string;
  heading: string;
  items: ExperienceItem[];
}

const { id, eyebrow, heading, items } = Astro.props;
---

<section id={id} class="section" aria-labelledby="experience-heading">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="experience-heading" class="section-title">{heading}</h2>
    </div>

    <div class="timeline">
      {
        items.map((item) => (
          <article class="card timeline-card">
            <span class="timeline-marker" aria-hidden="true"></span>
            <div class="timeline-header">
              <div>
                <h3 class="timeline-role">{item.role}</h3>
                <p class="timeline-company">{item.company}</p>
              </div>
              <span class="chip timeline-period">{item.period}</span>
            </div>

            <ul class="timeline-bullets prose">
              {item.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    display: grid;
    gap: var(--space-6);
    padding-left: var(--space-6);
    border-left: 1px solid var(--border);
  }

  .timeline-card {
    position: relative;
    min-width: 0;
  }

  .timeline-marker {
    position: absolute;
    left: calc(-1 * var(--space-6) - 6px);
    top: var(--space-6);
    width: 11px;
    height: 11px;
    border-radius: var(--radius-pill);
    background-color: var(--accent);
    border: 2px solid var(--bg);
  }

  .timeline-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3) var(--space-4);
    margin-bottom: var(--space-4);
  }

  .timeline-role {
    margin-bottom: var(--space-1);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .timeline-company {
    margin-bottom: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent);
  }

  .timeline-period {
    flex-shrink: 0;
  }

  .timeline-bullets {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-left: var(--space-4);
    color: var(--muted);
    font-size: 0.96875rem;
    line-height: 1.65;
  }

  @media (max-width: 480px) {
    .timeline {
      padding-left: var(--space-4);
    }

    .timeline-marker {
      left: calc(-1 * var(--space-4) - 6px);
    }
  }
</style>
