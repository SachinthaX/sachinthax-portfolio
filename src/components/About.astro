---
import type { LanguageItem } from "../data/content";

interface Props {
  id: string;
  eyebrow?: string;
  heading: string;
  paragraphs: string[];
  languages: LanguageItem[];
}

const { id, eyebrow, heading, paragraphs, languages } = Astro.props;
---

<section id={id} class="section" aria-labelledby="about-heading">
  <div class="container about-grid">
    <div class="section-header about-header">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 id="about-heading" class="section-title">
        {heading}
      </h2>
    </div>

    <div class="prose about-body">
      {paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}

      <div class="about-languages">
        <span class="about-languages-label">Languages:</span>{" "}
        <ul class="about-languages-list">
          {languages.map((lang, index) => (
            <li class="about-language-item">
              {index > 0 && (
                <span class="about-language-sep" aria-hidden="true">
                  {" · "}
                </span>
              )}
              <span>{`${lang.name}: ${lang.level}`}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 2fr);
    gap: var(--space-12);
    align-items: center;
  }

  .about-header {
    margin-bottom: 0;
  }

  .about-body {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
  }

  .about-body p {
    margin-bottom: 0;
    font-size: 1.03125rem;
    line-height: 1.7;
    color: var(--muted);
  }

  .about-languages {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-2);
    margin-top: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .about-languages-label {
    color: var(--accent);
    font-weight: 600;
  }

  .about-languages-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .about-language-item {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  @media (max-width: 840px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
      align-items: start;
    }

    .about-body {
      max-width: none;
    }
  }

  @media (max-width: 640px) {
    .about-languages {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-1);
    }

    .about-languages-list {
      flex-direction: column;
      gap: var(--space-1);
    }

    .about-language-sep {
      display: none;
    }
  }
</style>
