---
import type { LanguageItem } from '../data/content';

interface Props {
  id: string;
  eyebrow: string;
  heading: string;
  paragraphs: string[];
  languages: LanguageItem[];
}

const { id, eyebrow, heading, paragraphs, languages } = Astro.props;
---

<section id={id} class="section" aria-labelledby="about-heading">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="about-heading" class="section-title">{heading}</h2>
    </div>

    <div class="prose about-body">
      {paragraphs.map((paragraph) => <p>{paragraph}</p>)}

      <p class="about-languages">
        <span class="about-languages-label">Languages:</span>{" "}
        {languages.map((lang) => `${lang.name}: ${lang.level}`).join(' · ')}
      </p>
    </div>
  </div>
</section>

<style>
  .about-body {
    display: grid;
    gap: var(--space-4);
  }

  .about-body p {
    margin-bottom: 0;
    font-size: 1.03125rem;
    line-height: 1.7;
    color: var(--muted);
  }

  .about-body .about-languages {
    margin-top: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .about-languages-label {
    color: var(--accent);
    font-weight: 600;
  }
</style>
